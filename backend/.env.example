# ── Server ─────────────────────────────────────────────
# Render sets PORT automatically; used only for local dev.
PORT=5000
# "production" enables secure, cross-site (sameSite=none) auth cookies.
NODE_ENV=development
# Frontend origin, used for CORS and OAuth redirects (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Production (Neon): a single connection string. When set, DB_* below are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local development (individual fields)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=applytrack

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ── Google OAuth ───────────────────────────────────────
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
# Must match the authorized redirect URI in Google Cloud Console
# e.g. https://your-backend.onrender.com/auth/google/callback
CALLBACK_URL=http://localhost:5000/auth/google/callback
